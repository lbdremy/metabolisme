{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "metabolisme",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  // Notre entrée serveur, pas celle du framework : le plugin Cloudflare en
  // dérive l'entrée du build SSR et elle prime sur celle que TanStack Start
  // résout seul. C'est là que les fichiers de preuve trop lourds pour le CDN
  // sont servis depuis le stockage objet.
  "main": "./src/server.ts",
  // Domaine du site : Cloudflare crée et gère les enregistrements DNS et le
  // certificat des domaines personnalisés au déploiement.
  "routes": [
    { "pattern": "metabolisme.dev", "custom_domain": true },
    { "pattern": "www.metabolisme.dev", "custom_domain": true },
  ],
  "assets": {
    "binding": "ASSETS",
    // Les fichiers de contenu absents des assets (stockage objet) doivent
    // atteindre le Worker au lieu d'un 404 du CDN.
    "run_worker_first": ["/content/*"],
  },
  // Les sources figées de plus de 25 Mio (fichiers DVF, recensement…) ne
  // peuvent pas être des assets statiques : elles vivent dans un bucket et
  // sont servies en flux par le Worker.
  "r2_buckets": [
    {
      "binding": "EVIDENCE_FILES",
      "bucket_name": "metabolisme-evidence",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
